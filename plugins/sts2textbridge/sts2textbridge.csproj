<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>Sts2TextBridge</RootNamespace>
    <AssemblyName>sts2textbridge</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2Path)/data_sts2_linuxbsd_x86_64/sts2.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
